; Historia Terrarum 2 — HT2 Rebuild
; Godot 4.6.3

config_version=5

[application]

run/main_scene="res://scenes/main.tscn"
config/name="Historia Terrarum 2"
config/description="Grand strategy game — 10km Earth grid, binary land/water, viewport culling."
config/version="0.2.0"

[rendering]
renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080

[input]
zoom_in={
	"deadzone": 0.5,
	"events": [Object(InputEventMouseButton, "button_index": 4)]
}
zoom_out={
	"deadzone": 0.5,
	"events": [Object(InputEventMouseButton, "button_index": 5)]
}
orbit={
	"deadzone": 0.5,
	"events": [Object(InputEventMouseButton, "button_index": 2)]
}

[autoload]






